<!--
    A window containing a BlazorWebView. That is the entire XAML surface —
    the whole UI is Razor, so it can be edited in the same editor as the rest
    of the code.
-->
<Window x:Class="FabLog.FabPad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:local="clr-namespace:FabLog.FabPad.Components"
        Title="FabPad — ETCH bay, Fab 2"
        Height="900" Width="1180"
        Background="#12141A">
    <blazor:BlazorWebView x:Name="Web" HostPage="wwwroot\index.html">
        <blazor:BlazorWebView.RootComponents>
            <blazor:RootComponent Selector="#app" ComponentType="{x:Type local:Main}" />
        </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>
</Window>
