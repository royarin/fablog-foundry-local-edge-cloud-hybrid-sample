{
  "FabLog": {
    // CloudOnly | EdgeOnly | Hybrid — the three postures. Each names a PLACE where
    // work may run; none of them is a claim about how trustworthy that place is.
    "Mode": "CloudOnly",

    // The Central System — a destination in the fab's own jurisdiction, not a route
    // out. Every note is POSTed here in full, in every posture. It is trusted, and
    // it is in another room: from inside the cleanroom this is unreachable too, so
    // notes wait on the device until the technician walks out.
    "Hub": "https://localhost:5100",

    // ⚠️ The device's OWN wire to the vendor. Placeholders only — real
    // values go in appsettings.Development.json, which is gitignored.
    // T3Options.IsConfigured treats anything starting with '<' as not configured,
    // so the app starts and fails loudly on first use rather than half-working.
    "T3": {
      "Endpoint": "<https://your-resource.openai.azure.com>",
      "Deployment": "<your-deployment-name>",
      "ApiKey": "<your-api-key>",
      "TimeoutSeconds": 10
    },

    // The simulation switches. Starting state only — the UI toggle owns them from
    // then on. Set PadOnNetwork false to start inside the cleanroom.
    //
    // DrainIntervalSeconds is how often the device RETRIES what is waiting — not a
    // connectivity poll, because there is no such thing in this app. A send
    // succeeding is how it discovers the signal came back.
    "Demo": {
      "PadOnNetwork": true,
      "DrainIntervalSeconds": 2
    },

    "T1": {
      "ModelAlias": "qwen2.5-1.5b",
      "FallbackAlias": "qwen2.5-0.5b",
      "VariantPreference": [ "cuda-gpu", "trtrtx", "openvino", "generic-gpu", "generic-cpu" ],
      "ForceVariant": ""
    },

    "Author": "K. Nagy",

    // ⚠️ No "Shift" key here on purpose. A hardcoded calendar date goes stale the
    // day after it is written. DeviceOptions' own default computes BOTH halves at
    // launch — "Morning" or "Night" off the wall clock, plus the date of the shift
    // that began — matching HubStore's seed corpus, which uses the same two shift
    // names and floats the same way. Set this key explicitly only to pin a specific
    // value.

    // Note metadata that costs no inference to know: which handheld this is, and
    // which cleanroom it is in. Both travel with every note to the Central System.
    "DeviceId": "PAD-07",
    "Cleanroom": "CR-2"
  }
}
