<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    The ONLY dependency Core takes.

    Not the Foundry Local SDK, not the Azure SDK. The abstraction is
    IChatClient, which ships with .NET — so every tier is the same type here
    and construction happens in each app's composition root instead.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.0" />
  </ItemGroup>

</Project>
