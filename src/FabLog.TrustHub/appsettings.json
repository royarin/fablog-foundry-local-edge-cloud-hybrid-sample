{
  "FabLog": {
    "T3": {
      "Endpoint": "<https://your-resource.openai.azure.com/>",
      "Deployment": "<your-gpt-4o-deployment-name>",
      "TimeoutSeconds": 10,
      "ApiKey": "<set in appsettings.Development.json — never commit a key>"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "FabLog": "Information"
    }
  },
  "AllowedHosts": "*"
}
